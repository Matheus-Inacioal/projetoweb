# ============================================================
# BarberGo — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha com seus dados.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- Mercado Pago (PIX) ---
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# Deixe vazio ou "SEU_ACCESS_TOKEN" para usar o modo Mock (acadêmico)
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN

# --- URL Base da Aplicação ---
# Usado para webhooks do Mercado Pago
NEXT_PUBLIC_BASE_URL=http://localhost:3000
